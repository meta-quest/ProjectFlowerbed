<!--
  Drop targets beside a print held in the left hand (legacy camera action
  tiles): release the print over Keep to file it in the garden's album, or
  over Discard to throw it away. Tiles light up while the print is over them.
  Not clickable: the right hand holds the camera. Driven by
  src/camera/camera-system.ts.
-->
<style>
  .column {
    flex-direction: column;
    gap: 3;
  }

  .tile {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.2;
    width: 18;
    height: 18;
    border-radius: 3;
    background-color: #15211b;
    border-width: 0.4;
    border-color: #35503f;
  }

  .icon {
    width: 3.8;
    height: 3.8;
  }

  .label {
    color: #f6f3ea;
    font-size: 2.4;
    font-weight: 700;
  }
</style>
<div class="column">
  <div class="tile" id="drop-keep">
    <BookImage class="icon" id="drop-keep-icon" color="#86dc3d"></BookImage>
    <span class="label">Keep</span>
  </div>
  <div class="tile" id="drop-discard">
    <Trash2 class="icon" id="drop-discard-icon" color="#e2725b"></Trash2>
    <span class="label">Discard</span>
  </div>
</div>
