<!--
  Radial tool dial that blooms from the right controller (A button).
  Six round tiles sit on a 15 cm ring around a hub that names the focused
  tool. Tiles are addressed by id from src/ui/tool-dial-system.ts; the active
  tool gets an accent ring, the focused one lifts and brightens.
-->
<style>
  .dial {
    width: 44;
    height: 44;
  }

  .hub {
    position-type: absolute;
    position-left: 13;
    position-top: 13;
    width: 18;
    height: 18;
    border-radius: 9;
    background-color: #14201b;
    border-width: 0.3;
    border-color: #3b4f45;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6;
    padding-left: 1.6;
    padding-right: 1.6;
  }

  .hub-title {
    color: #f4f1e8;
    font-size: 2.6;
    font-weight: 700;
    text-align: center;
  }

  .hub-hint {
    color: #b9c9bf;
    font-size: 1.45;
    line-height: 1.3;
    text-align: center;
  }

  .tile {
    position-type: absolute;
    width: 11;
    height: 11;
    border-radius: 5.5;
    background-color: #1c2a24;
    border-width: 0.35;
    border-color: #33463d;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5;
  }

  .tile-label {
    color: #e8efe9;
    font-size: 1.7;
    font-weight: 600;
  }

  .icon {
    width: 3.3;
    height: 3.3;
  }
</style>
<div class="dial" id="dial">
  <div class="tile" id="tile-seeds" style="position-left: 16.5; position-top: 1.5">
    <Sprout class="icon" id="icon-seeds" color="#86dc3d"></Sprout>
    <span class="tile-label">Seeds</span>
  </div>
  <div class="tile" id="tile-water" style="position-left: 29.49; position-top: 9">
    <Droplets class="icon" id="icon-water" color="#5aa7ff"></Droplets>
    <span class="tile-label">Water</span>
  </div>
  <div class="tile" id="tile-remove" style="position-left: 29.49; position-top: 24">
    <Shovel class="icon" id="icon-remove" color="#ef8a6f"></Shovel>
    <span class="tile-label">Remove</span>
  </div>
  <div class="tile" id="tile-camera" style="position-left: 16.5; position-top: 31.5">
    <Camera class="icon" id="icon-camera" color="#f6c443"></Camera>
    <span class="tile-label">Camera</span>
  </div>
  <div class="tile" id="tile-explore" style="position-left: 3.51; position-top: 24">
    <Footprints class="icon" id="icon-explore" color="#8fb8de"></Footprints>
    <span class="tile-label">Explore</span>
  </div>
  <div class="tile" id="tile-settings" style="position-left: 3.51; position-top: 9">
    <Settings class="icon" id="icon-settings" color="#c3a6ea"></Settings>
    <span class="tile-label">Settings</span>
  </div>
  <div class="hub">
    <span class="hub-title" id="hub-title">Tools</span>
    <span class="hub-hint" id="hub-hint">Point, touch or flick the stick</span>
  </div>
</div>
