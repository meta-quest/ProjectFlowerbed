<!--
  Brief confirmation chip shown above the right hand after switching tools.
-->
<style>
  .chip {
    flex-direction: row;
    align-items: center;
    gap: 8;
    padding-top: 8;
    padding-bottom: 8;
    padding-left: 12;
    padding-right: 16;
    border-radius: 20;
    background-color: #15211b;
    border-width: 1.5;
    border-color: #86dc3d;
  }

  .dot {
    width: 12;
    height: 12;
    border-radius: 6;
    background-color: #86dc3d;
  }

  .label {
    color: #f6f3ea;
    font-size: 18;
    font-weight: 700;
  }

  .sub {
    color: #9fb3a7;
    font-size: 14;
  }

  .text {
    flex-direction: column;
    gap: 1;
  }
</style>
<div class="chip" id="chip-root">
  <div class="dot" id="chip-dot"></div>
  <div class="text">
    <span class="label" id="chip-label">Seeds</span>
    <span class="sub" id="chip-sub">Pick a seed, aim, release the trigger</span>
  </div>
</div>
